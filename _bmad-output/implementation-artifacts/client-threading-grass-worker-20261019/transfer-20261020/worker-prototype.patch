+    tile.matrices instanceof Float32Array &&
+    tile.matrices.buffer instanceof ArrayBuffer &&
+    tile.matrices.byteOffset === 0 &&
+    tile.matrices.length === tile.count * 16 &&
+    tile.matrices.byteLength === tile.matrices.buffer.byteLength &&
