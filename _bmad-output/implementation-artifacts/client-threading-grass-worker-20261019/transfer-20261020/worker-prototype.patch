+      }
+    | undefined;
+  let cancelScheduled: (() => void) | undefined;
+  function clear() {
+    active?.work.return(undefined);
+    active = undefined;
+    requests.clear();
+    cancelScheduled?.();
+    cancelScheduled = undefined;
+  }
+  function dispose() {
+    if (disposed) return;
+    disposed = true;
+    clear();
+    placement.dispose();
+  }
+  function wake() {
+    if (!disposed && !cancelScheduled && requests.size)
+      cancelScheduled = schedule(pump);
+  }
+  function pump() {
+    cancelScheduled = undefined;
+    if (disposed) return;
+    try {
+      const deadline = now() + GRASS_PREPARATION.milliseconds;
+      let completed = 0;
+      for (let step = 0; step < GRASS_PREPARATION.steps; step++) {
+        if (!active) {
+          const request = requests.values().next().value as
+            GrassTileRequest | undefined;
+          if (!request) break;
+          active = {
+            request,
+            work: placement.prepareTile(request.x, request.z),
+            cpuMs: 0,
+          };
+        }
+        const started = now();
+        const result = active.work.next();
+        const ended = now();
+        active.cpuMs += ended - started;
+        if (result.done) {
+          const request = active.request,
+            tile = result.value,
+            cpuMs = active.cpuMs;
+          if (!tile || !placement.releaseTile(tile))
+            throw Error("Unowned grass tile");
+          requests.delete(request.requestId);
+          active = undefined;
+          // releaseTile MUST precede detachment: no cached typed array survives.
+          post(
+            {
+              kind: "tile",
+              protocol: GRASS_WORKER_PROTOCOL,
+              epoch,
+              requestId: request.requestId,
+              tile,
+              cpuMs,
+            },
+            [tile.matrices.buffer as ArrayBuffer],
+          );
+          if (++completed >= GRASS_PREPARATION.coldTiles) break;
+        }
+        if (ended >= deadline) break;
+      }
+      wake();
+    } catch {
+      dispose();
+      post({ kind: "error", protocol: GRASS_WORKER_PROTOCOL });
+    }
+  }
+  return {
+    receive(message: GrassWorkerInput) {
+      if (disposed) return;
+      if (message.protocol !== GRASS_WORKER_PROTOCOL) {
+        dispose();
+        post({ kind: "error", protocol: GRASS_WORKER_PROTOCOL });
+        return;
+      }
+      if (message.kind === "reset") {
+        if (message.epoch > epoch) {
+          clear();
+          epoch = message.epoch;
+        }
+        return;
+      }
+      if (message.epoch !== epoch) return;
+      if (message.kind === "cancel") {
+        if (active?.request.requestId === message.requestId) {
+          active.work.return(undefined);
+          active = undefined;
+        }
+        requests.delete(message.requestId);
+        return;
+      }
+      if (requests.has(message.requestId)) return;
+      if (
+        requests.size >= GRASS_WORKER_INFLIGHT ||
+        !Number.isSafeInteger(message.x) ||
+        !Number.isSafeInteger(message.z)
+      ) {
+        dispose();
+        post({ kind: "error", protocol: GRASS_WORKER_PROTOCOL });
+        return;
+      }
+      requests.set(message.requestId, message);
+      wake();
+    },
+    dispose,
+  };
+}
+
+// Node tests import the runtime without constructing a browser or engine.
+if (typeof self !== "undefined" && typeof Window === "undefined") {
+  const runtime = createPhotoGrassWorkerRuntime((message, transfer = []) =>
+    self.postMessage(message, { transfer }),
+  );
+  self.onmessage = (event: MessageEvent<GrassWorkerInput>) =>
+    runtime.receive(event.data);
+  self.postMessage({ kind: "ready", protocol: GRASS_WORKER_PROTOCOL });
+}
diff --git a/client/photo-grass-worker-protocol.ts b/client/photo-grass-worker-protocol.ts
new file mode 100644
index 0000000000000000000000000000000000000000..111f923efc44efb111bb4f902d70854dcf582583
--- /dev/null
+++ b/client/photo-grass-worker-protocol.ts
@@ -0,0 +1,61 @@
+import type { PhotoGrassTile } from "./photo-grass-placement";
+
+export const GRASS_WORKER_PROTOCOL = 1;
+export const GRASS_WORKER_INFLIGHT = 2;
+// Experimental failure bounds, not performance targets. Bootstrap can duplicate
+// world-data initialization; meanwhile the original main-thread path keeps working.
+export const GRASS_WORKER_STARTUP_MS = 5000;
+export const GRASS_WORKER_REQUEST_MS = 500;
+
+export type GrassTileRequest = {
+  kind: "tile";
+  protocol: typeof GRASS_WORKER_PROTOCOL;
+  epoch: number;
+  requestId: number;
+  x: number;
+  z: number;
+};
+export type GrassWorkerInput =
+  | GrassTileRequest
+  | {
+      kind: "cancel";
+      protocol: typeof GRASS_WORKER_PROTOCOL;
+      epoch: number;
+      requestId: number;
+    }
+  | {
+      kind: "reset";
+      protocol: typeof GRASS_WORKER_PROTOCOL;
+      epoch: number;
+    };
+export type GrassWorkerOutput =
+  | {
+      kind: "ready";
+      protocol: typeof GRASS_WORKER_PROTOCOL;
+    }
+  | {
+      kind: "tile";
+      protocol: typeof GRASS_WORKER_PROTOCOL;
+      epoch: number;
+      requestId: number;
+      tile: PhotoGrassTile;
+      cpuMs: number;
+    }
+  | {
+      kind: "error";
+      protocol: typeof GRASS_WORKER_PROTOCOL;
+    };
+
+export function grassWorkerEnabled(location: {
+  hostname: string;
+  search: string;
+}) {
+  const values = new URLSearchParams(location.search).getAll("grassWorker");
+  return (
+    ["localhost", "127.0.0.1", "[::1]", "::1"].includes(
+      location.hostname.toLowerCase(),
+    ) &&
+    values.length === 1 &&
+    values[0] === "1"
+  );
+}
diff --git a/client/photo-grass-tile-executor.ts b/client/photo-grass-tile-executor.ts
new file mode 100644
index 0000000000000000000000000000000000000000..6ceff286752dde7672aba6e0acd6b0107e118b00
--- /dev/null
+++ b/client/photo-grass-tile-executor.ts
@@ -0,0 +1,253 @@
+import { isPhotoGrassTile, type PhotoGrassTile } from "./photo-grass-placement";
+import {
+  GRASS_WORKER_PROTOCOL,
+  GRASS_WORKER_INFLIGHT,
+  GRASS_WORKER_STARTUP_MS,
+  GRASS_WORKER_REQUEST_MS,
+  grassWorkerEnabled,
+  type GrassWorkerInput,
+  type GrassTileRequest,
+} from "./photo-grass-worker-protocol";
+
+export type PhotoGrassWorkerPort = {
+  postMessage(message: GrassWorkerInput): void;
+  terminate(): void;
+  onmessage: ((event: { data: unknown }) => void) | null;
+  onerror: (() => void) | null;
+  onmessageerror: (() => void) | null;
+};
+type Pending = GrassTileRequest & {
+  sentAt: number;
+  received?: { tile: unknown; cpuMs: unknown; at: number };
+};
+
+/** Transport only. No cache, render state, timers or async mutation of the lawn. */
+export class PhotoGrassTileExecutor {
+  readonly stats = {
+    experimental: true,
+    state: "starting",
+    requested: 0,
+    completed: 0,
+    cancelled: 0,
+    startupMs: 0,
+    // Completed tiles only; cancelled partial computation is not reported.
+    workerCpuMs: 0,
+    workerMaxCpuMs: 0,
+    waitMs: 0,
+    maxWaitMs: 0,
+    applyMs: 0,
+    maxApplyMs: 0,
+    failure: "",
+  };
+  private port?: PhotoGrassWorkerPort;
+  private pending = new Map<number, Pending>();
+  private epoch = 1;
+  private nextId = 1;
+  private startedAt: number;
+  private state: "starting" | "ready" | "failed" | "disposed" = "starting";
+  failure?: string;
+
+  constructor(
+    create: () => PhotoGrassWorkerPort,
+    private now = () => performance.now(),
+  ) {
+    this.startedAt = now();
+    try {
+      this.port = create();
+      this.port.onmessage = ({ data }) => this.receive(data);
+      this.port.onerror = () => this.fail("worker error");
+      this.port.onmessageerror = () => this.fail("worker message error");
+    } catch {
+      this.fail("worker construction failed");
+    }
+  }
+  get ready() {
+    return this.state === "ready";
+  }
+  get failed() {
+    return this.state === "failed";
+  }
+  get pendingCount() {
+    return this.pending.size;
+  }
+  get requests(): Iterable<Readonly<GrassTileRequest>> {
+    return this.pending.values();
+  }
+  has(x: number, z: number) {
+    for (const request of this.pending.values())
+      if (request.x === x && request.z === z) return true;
+    return false;
+  }
+  checkTimeout() {
+    const now = this.now();
+    if (
+      this.state === "starting" &&
+      now - this.startedAt >= GRASS_WORKER_STARTUP_MS
+    )
+      this.fail("worker startup timeout");
+    if (this.state === "ready")
+      for (const request of this.pending.values())
+        if (
+          !request.received &&
+          now - request.sentAt >= GRASS_WORKER_REQUEST_MS
+        ) {
+          this.fail("worker tile timeout");
+          break;
+        }
+  }
+  request(x: number, z: number) {
+    if (
+      !this.ready ||
+      this.pending.size >= GRASS_WORKER_INFLIGHT ||
+      this.has(x, z)
+    )
+      return false;
+    const request: Pending = {
+      kind: "tile",
+      protocol: GRASS_WORKER_PROTOCOL,
+      epoch: this.epoch,
+      requestId: this.nextId++,
+      x,
+      z,
+      sentAt: this.now(),
+    };
+    this.pending.set(request.requestId, request);
+    this.stats.requested++;
+    this.send(request);
+    return !this.failed;
+  }
+  cancel(x: number, z: number) {
+    for (const request of this.pending.values())
+      if (request.x === x && request.z === z) {
+        this.pending.delete(request.requestId);
+        this.stats.cancelled++;
+        this.send({
+          kind: "cancel",
+          protocol: GRASS_WORKER_PROTOCOL,
+          epoch: this.epoch,
+          requestId: request.requestId,
+        });
+        return;
+      }
+  }
+  takeCompleted(): PhotoGrassTile | undefined {
+    if (!this.ready) return;
+    for (const request of this.pending.values()) {
+      if (!request.received) continue;
+      const tile = request.received.tile;
+      if (
+        !isPhotoGrassTile(tile) ||
+        tile.x !== request.x + 0.5 ||
+        tile.z !== request.z + 0.5 ||
+        typeof request.received.cpuMs !== "number" ||
+        !Number.isFinite(request.received.cpuMs) ||
+        request.received.cpuMs < 0
+      ) {
+        this.fail("invalid worker tile");
+        return;
+      }
+      const cpuMs = request.received.cpuMs,
+        waitMs = Math.max(0, request.received.at - request.sentAt);
+      this.stats.completed++;
+      this.stats.workerCpuMs += cpuMs;
+      this.stats.workerMaxCpuMs = Math.max(this.stats.workerMaxCpuMs, cpuMs);
+      this.stats.waitMs += waitMs;
+      this.stats.maxWaitMs = Math.max(this.stats.maxWaitMs, waitMs);
+      this.pending.delete(request.requestId);
+      return tile;
+    }
+  }
+  reset() {
+    this.epoch++;
+    this.stats.cancelled += this.pending.size;
+    this.pending.clear();
+    this.send({
+      kind: "reset",
+      protocol: GRASS_WORKER_PROTOCOL,
+      epoch: this.epoch,
+    });
+  }
+  recordApply(milliseconds: number) {
+    this.stats.applyMs += milliseconds;
+    this.stats.maxApplyMs = Math.max(this.stats.maxApplyMs, milliseconds);
+  }
+  private receive(data: unknown) {
+    if (this.state === "disposed" || this.failed) return;
+    if (!data || typeof data !== "object") {
+      this.fail("invalid worker message");
+      return;
+    }
+    const message = data as Record<string, unknown>;
+    if (message.protocol !== GRASS_WORKER_PROTOCOL) {
+      this.fail("worker protocol mismatch");
+      return;
+    }
+    if (message.kind === "ready") {
+      if (this.state === "starting")
+        this.stats.startupMs = Math.max(0, this.now() - this.startedAt);
+      this.state = "ready";
+      this.stats.state = "ready";
+      return;
+    }
+    if (message.kind === "error") {
+      this.fail("worker computation failed");
+      return;
+    }
+    if (message.kind !== "tile") {
+      this.fail("invalid worker message");
+      return;
+    }
+    if (message.epoch !== this.epoch) return;
+    const request = this.pending.get(message.requestId as number);
+    // At most two retained payloads. Duplicate/cancelled responses never queue.
+    if (request && !request.received)
+      request.received = {
+        tile: message.tile,
+        cpuMs: message.cpuMs,
+        at: this.now(),
+      };
+  }
+  private send(message: GrassWorkerInput) {
+    if (!this.port || this.failed || this.state === "disposed") return;
+    try {
+      this.port.postMessage(message);
+    } catch {
+      this.fail("worker send failed");
+    }
+  }
+  private detach() {
+    const port = this.port;
+    this.port = undefined;
+    if (port) {
+      port.onmessage = port.onerror = port.onmessageerror = null;
+      port.terminate();
+    }
+  }
+  private fail(reason: string) {
+    if (this.state === "disposed" || this.failed) return;
+    this.state = "failed";
+    this.failure = reason;
+    this.stats.state = "failed";
+    this.stats.failure = reason;
+    // Keep requests until update requeues them for the original generator.
+    this.detach();
+  }
+  dispose() {
+    if (this.state === "disposed") return;
+    this.state = "disposed";
+    if (!this.stats.failure) this.stats.state = "disposed";
+    this.detach();
+    this.pending.clear();
+  }
+}
+
+export function createExperimentalGrassTileExecutor() {
+  if (typeof location === "undefined" || !grassWorkerEnabled(location)) return;
+  return new PhotoGrassTileExecutor(
+    () =>
+      new Worker(new URL("./photo-grass-worker.ts", import.meta.url), {
+        type: "module",
+        name: "photographic-grass-tiles",
+      }) as unknown as PhotoGrassWorkerPort,
+  );
+}
diff --git a/tests/photo-grass-worker.test.ts b/tests/photo-grass-worker.test.ts
new file mode 100644
index 0000000000000000000000000000000000000000..661ce1bfbf783fb641a6953df2ab94d134c33d94
--- /dev/null
+++ b/tests/photo-grass-worker.test.ts
@@ -0,0 +1,266 @@
+import test from "node:test";
+import assert from "node:assert/strict";
+import { createPhotoGrassPlacement } from "../client/photo-grass-placement";
+import {
+  PhotoGrassTileExecutor,
+  type PhotoGrassWorkerPort,
+} from "../client/photo-grass-tile-executor";
+import { createPhotoGrassWorkerRuntime } from "../client/photo-grass-worker";
+import {
+  GRASS_WORKER_PROTOCOL,
+  GRASS_WORKER_STARTUP_MS,
+  GRASS_WORKER_REQUEST_MS,
+  grassWorkerEnabled,
+  type GrassWorkerInput,
+  type GrassWorkerOutput,
+} from "../client/photo-grass-worker-protocol";
+
+/** Deterministic scheduling, but REAL structured-clone transfer/detachment. */
+class WorkerHarness implements PhotoGrassWorkerPort {
+  onmessage: PhotoGrassWorkerPort["onmessage"] = null;
+  onerror: PhotoGrassWorkerPort["onerror"] = null;
+  onmessageerror: PhotoGrassWorkerPort["onmessageerror"] = null;
+  inputs: GrassWorkerInput[] = [];
+  outputs: GrassWorkerOutput[] = [];
+  detached: number[] = [];
+  terminated = 0;
+  private callbacks = new Set<() => void>();
+  private runtime: ReturnType<typeof createPhotoGrassWorkerRuntime>;
+  constructor(now = () => 0) {
+    this.runtime = createPhotoGrassWorkerRuntime(
+      (message, transfer = []) => {
+        this.outputs.push(structuredClone(message, { transfer }));
+        for (const buffer of transfer) this.detached.push(buffer.byteLength);
+      },
+      (run) => {
+        this.callbacks.add(run);
+        return () => this.callbacks.delete(run);
+      },
+      now,
+    );
+  }
+  postMessage(message: GrassWorkerInput) {
+    this.inputs.push(message);
+    this.runtime.receive(message);
+  }
+  terminate() {
+    this.terminated++;
+    this.runtime.dispose();
+  }
+  ready() {
+    this.onmessage?.({
+      data: { kind: "ready", protocol: GRASS_WORKER_PROTOCOL },
+    });
+  }
+  slice() {
+    const run = this.callbacks.values().next().value;
+    if (!run) return false;
+    this.callbacks.delete(run);
+    run();
+    return true;
+  }
+  finish() {
+    for (let i = 0; i < 100 && this.slice(); i++);
+  }
+  deliver() {
+    for (const data of this.outputs.splice(0)) this.onmessage?.({ data });
+  }
+}
+
+test("worker experiment requires exactly one explicit loopback opt-in", () => {
+  for (const hostname of ["localhost", "127.0.0.1", "[::1]", "::1"])
+    assert.equal(
+      grassWorkerEnabled({ hostname, search: "?grassWorker=1" }),
+      true,
+    );
+  for (const search of [
+    "",
+    "?grassWorker=0",
+    "?grassWorker=true",
+    "?grassWorker=1&grassWorker=1",
+  ])
+    assert.equal(grassWorkerEnabled({ hostname: "localhost", search }), false);
+  assert.equal(
+    grassWorkerEnabled({
+      hostname: "localhost.example.com",
+      search: "?grassWorker=1",
+    }),
+    false,
+  );
+});
+
+test("transferred tiles preserve exact matrices, repeat requests and main FIFO ownership", () => {
+  const port = new WorkerHarness(),
+    executor = new PhotoGrassTileExecutor(
+      () => port,
+      () => 0,
+    ),
+    native = createPhotoGrassPlacement(),
+    cache = createPhotoGrassPlacement(1536);
+  try {
+    port.ready();
+    assert.equal(executor.request(110, 34), true);
+    assert.equal(executor.request(333, -110), true);
+    assert.equal(
+      executor.request(111, 35),
+      false,
+      "no third in-flight request",
+    );
+    port.finish();
+    assert.equal(
+      cache.cacheSize,
+      0,
+      "worker handler does not populate main cache",
+    );
+    port.deliver();
+    assert.equal(
+      executor.pendingCount,
+      2,
+      "completed payloads still occupy slots",
+    );
+    const first = executor.takeCompleted()!,
+      edge = executor.takeCompleted()!;
+    assert.deepEqual(first, native.tile(110, 34));
+    assert.deepEqual(edge, native.tile(333, -110));
+    cache.acceptTile(first);
+    cache.acceptTile(edge);
+    assert.deepEqual(port.detached, [0, 0]);
+    assert.equal(executor.request(110, 34), true);
+    port.finish();
+    port.deliver();
+    const repeated = executor.takeCompleted()!;
+    assert.deepEqual(repeated, first, "worker has no detached cache hit");
+    assert.equal(
+      cache.acceptTile(repeated),
+      first,
+      "cache identity survives duplicate arrival",
+    );
+    for (let i = 0; i < 1535; i++) cache.tile(-2000 - i, -2000);
+    assert.equal(cache.cacheSize, 1536);
+    assert.equal(
+      cache.cachedTile(110, 34),
+      undefined,
+      "a cache hit must not promote FIFO order",
+    );
+    assert.ok(cache.cachedTile(333, -110));
+    assert.deepEqual(
+      cache.tile(110, 34),
+      first,
+      "eviction preserves deterministic regeneration",
+    );
+    assert.equal(
+      cache.releaseTile({ ...cache.tile(110, 34) }),
+      false,
+      "only the owned object may transfer",
+    );
+    assert.throws(
+      () => cache.acceptTile({ ...first, count: first.count + 1 }),
+      /Invalid/,
+    );
+  } finally {
+    executor.dispose();
+    native.dispose();
+    cache.dispose();
+  }
+});
+
+test("cancel between yielded slices publishes no tile and reset rejects old epoch/duplicates", () => {
+  let clock = 0;
+  const port = new WorkerHarness(() => (clock += 3)),
+    executor = new PhotoGrassTileExecutor(
+      () => port,
+      () => 0,
+    );
+  try {
+    port.ready();
+    executor.request(110, 34);
+    assert.equal(port.slice(), true);
+    executor.cancel(110, 34);
+    port.finish();
+    port.deliver();
+    assert.equal(executor.takeCompleted(), undefined);
+    assert.equal(port.outputs.length, 0);
+    executor.request(110, 34);
+    port.finish();
+    const old = port.outputs[0];
+    assert.equal(old.kind, "tile");
+    executor.reset();
+    port.deliver();
+    assert.equal(executor.takeCompleted(), undefined);
+    executor.request(110, 34);
+    port.finish();
+    const current = port.outputs[0];
+    port.deliver();
+    port.onmessage?.({ data: current });
+    assert.equal(executor.pendingCount, 1);
+    assert.ok(executor.takeCompleted());
+    port.onmessage?.({ data: current });
+    assert.equal(executor.pendingCount, 0);
+    const late = port.onmessage;
+    executor.dispose();
+    late?.({ data: current });
+    assert.equal(executor.pendingCount, 0);
+    assert.equal(port.terminated, 1);
+    assert.equal(port.onmessage, null);
+  } finally {
+    executor.dispose();
+  }
+});
+
+test("startup, request, transport and malformed-result failures terminate before fallback", () => {
+  let clock = 0;
+  const startup = new WorkerHarness(),
+    starting = new PhotoGrassTileExecutor(
+      () => startup,
+      () => clock,
+    );
+  clock = GRASS_WORKER_STARTUP_MS;
+  starting.checkTimeout();
+  assert.equal(starting.failed, true);
+  assert.equal(startup.terminated, 1);
+  starting.dispose();
+  const unavailable = new PhotoGrassTileExecutor(() => {
+    throw Error("unavailable");
+  });
+  assert.equal(unavailable.failed, true);
+  unavailable.dispose();
+  for (const failure of [
+    "timeout",
+    "error",
+    "messageerror",
+    "send",
+    "tile",
+  ] as const) {
+    const port = new WorkerHarness(),
+      executor = new PhotoGrassTileExecutor(
+        () => port,
+        () => clock,
+      );
+    port.ready();
+    if (failure === "send")
+      port.postMessage = () => {
+        throw Error("send");
+      };
+    executor.request(110, 34);
+    if (failure === "timeout") {
+      clock += GRASS_WORKER_REQUEST_MS;
+      executor.checkTimeout();
+    }
+    if (failure === "error") port.onerror?.();
+    if (failure === "messageerror") port.onmessageerror?.();
+    if (failure === "tile") {
+      const request = [...executor.requests][0];
+      port.onmessage?.({ data: { ...request, tile: { count: 0 } } });
+      executor.takeCompleted();
+    }
+    assert.equal(executor.failed, true, failure);
+    assert.equal(port.terminated, 1, failure);
+    assert.deepEqual(
+      [...executor.requests].map((r) => [r.x, r.z]),
+      [[110, 34]],
+      "failed work remains available to native fallback",
+    );
+    executor.dispose();
+    assert.equal(executor.pendingCount, 0);
+  }
+});
