# Optional overrides for compose.full.yaml. The defaults need no .env file.
# Put the raw OpenAI API key in secrets/openai_api_key.txt (ignored by Git).
OPENAI_SECRET_FILE=./secrets/openai_api_key.txt
HTTP_PORT=8080
BIND_ADDRESS=127.0.0.1
OPENAI_MODEL=gpt-6-luna
OPENAI_REASONING_EFFORT=none
# Finite allowance for changed/new inputs; bundled compatible vectors need no API calls.
RAG_BOOTSTRAP_MAX_INPUTS=256
RAG_BOOTSTRAP_MAX_BYTES=1048576
