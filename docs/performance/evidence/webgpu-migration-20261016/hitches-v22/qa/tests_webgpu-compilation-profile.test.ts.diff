+test("stage limit keeps default16 and only explicit values can use the bounded21 ceiling", () => {
+  for (const [requested, expected] of [
+    [undefined, 16], [19, 19], [21, 21], [999, 21], [19.9, 19],
+    [Number.NaN, 16], [Infinity, 16], [-1, 2], [0, 2],
+  ] as const) {
+    const f = inventoryFixture(requested === undefined ? {} : { shaderInventoryLimits: { maxStages: requested } });
+    try {
+      const limits = f.profile.snapshot().shaderInventory!.limits;
+      assert.equal(limits.maxStages, expected, String(requested));
+      assert.equal(limits.maxEntries, 1024);
+      assert.equal(limits.maxCodeUnits, 32 * 1024 * 1024);
+      assert.equal(limits.maxRows, 16);
+    } finally { f.profile.dispose(); }
+  }
+});
