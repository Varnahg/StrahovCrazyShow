+test("GPU completion fence rejects foreign generations, devices, renderer identity and unhealthy state", async (t) => {
+  for (const phase of ["observer", "promise"]) for (const mutation of ["health", "profile", "device", "renderer", "invalid"]) {
+    const f = fenceFixture(); t.after(() => f.recorder.dispose());
+    f.recorder.start(); await f.recorder.flush(); f.game.frame();
+    if (phase === "promise") f.endFrame.notifyObservers(f.game.engine);
+    if (mutation === "health") f.nextHealth();
+    if (mutation === "profile") f.nextProfile();
+    if (mutation === "device") f.game.engine._device = { queue: f.queue };
+    if (mutation === "renderer") f.game.renderHealth.snapshot = () => ({ rendererId: 74, generation: 3, valid: true });
+    if (mutation === "invalid") f.game.renderHealth.snapshot = () => ({ rendererId: 73, generation: 3, valid: false });
+    f.endFrame.notifyObservers(f.game.engine); f.resolve(); await Promise.resolve(); await f.recorder.flush();
+    assert.equal(f.calls(), phase === "observer" ? 0 : 1, `${phase}/${mutation}`);
+    assert.equal(f.game.pendingGpuCompletionFence, undefined, `${phase}/${mutation}`);
+    assert.deepEqual(f.fenceRecords().map(r => r.data.status), phase === "observer" ? [] : ["queued"], `${phase}/${mutation}`);
+  }
+});
