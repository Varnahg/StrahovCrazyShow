+function fenceFixture() {
+  const f = fixture();
+  const endFrame = new Observable<any>();
+  let calls = 0, healthGeneration = 3, profileGeneration = 5;
+  let resolve!: () => void, reject!: (reason?: unknown) => void;
+  const completion = new Promise<void>((yes, no) => { resolve = yes; reject = no; });
+  const queue = { onSubmittedWorkDone() { assert.equal(this, queue); calls++; return completion; } };
+  const device = { queue };
+  Object.assign(f.game.engine, { isWebGPU: true, _device: device, onEndFrameObservable: endFrame });
+  f.game.renderHealth = {
+    rendererId: 73, dispose() {},
+    snapshot: () => ({ rendererId: 73, generation: healthGeneration, valid: true, phase: "ready" }),
+  };
+  f.game.frameLifecycleProfile = {
+    snapshot: () => ({ active: true, generation: profileGeneration, rawRaf: { epoch: 2 } }),
+    dispose() {},
+  };
+  const render = f.game.scene.render;
+  f.game.scene.render = () => { render(); f.advance(300); };
+  return { ...f, endFrame, queue, device, resolve, reject, calls: () => calls,
+    nextHealth: () => healthGeneration++, nextProfile: () => profileGeneration++,
+    fenceRecords: () => f.records().filter(r => r.kind === "engine-frame-profile" && r.data.stage === "gpu-completion-fence"),
+  };
+}
+
+test("GPU completion fence waits for endFrame and permits only one outstanding fence across CPU bursts", async (t) => {
+  const f = fenceFixture(); t.after(() => f.recorder.dispose());
+  f.recorder.start(); await f.recorder.flush();
+  f.game.frame(); f.game.frame();
+  assert.equal(f.calls(), 0);
+  assert.equal(f.endFrame.observers.length, 1);
+  assert.equal(f.renders(), 2);
+  f.endFrame.notifyObservers(f.game.engine);
+  assert.equal(f.calls(), 1);
+  f.game.frame(); f.endFrame.notifyObservers(f.game.engine);
+  assert.equal(f.calls(), 1);
+  await f.recorder.flush();
+  const queued = f.fenceRecords()[0].data;
+  assert.equal(queued.status, "queued");
+  assert.equal(queued.rendererId, 73);
+  assert.equal(queued.generation, 3);
+  assert.equal(queued.engineGeneration, 5);
+  assert.equal(queued.rawRafEpoch, 2);
+  assert.equal(queued.probeId, 1);
+  assert.ok(Number(queued.cpuFrameMs) >= 300);
+  assert.equal(Number(queued.cpuFrameEndMs) - Number(queued.cpuFrameStartMs), queued.cpuFrameMs);
+  f.advance(1200); f.resolve(); await Promise.resolve(); await f.recorder.flush();
+  const completed = f.fenceRecords()[1].data;
+  assert.equal(completed.status, "completed");
+  assert.equal(completed.probeId, queued.probeId);
+  assert.equal(completed.queuedAtMs, queued.queuedAtMs);
+  assert.equal(completed.completionLatencyMs, Number(completed.completedAtMs) - Number(queued.queuedAtMs));
+  assert.ok(Number(completed.completionLatencyMs) >= 1200);
+  f.game.frame(); f.endFrame.notifyObservers(f.game.engine); await Promise.resolve(); await f.recorder.flush();
+  assert.equal(f.calls(), 2);
+  assert.equal(f.fenceRecords()[2].data.probeId, 2);
+  for (const batch of f.posts) assert.ok(validateDiagnosticsBatch(batch));
+});
