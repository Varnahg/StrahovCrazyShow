+test("GPU completion fence follows submit in the pinned real WebGPU endFrame and flushFramebuffer methods", async (t) => {
+  const f = fenceFixture(); t.after(() => f.recorder.dispose());
+  const order: string[] = [];
+  const encoder = () => ({ finish: () => ({}) });
+  Object.assign(f.device, { createCommandEncoder: encoder });
+  Object.assign(f.queue, { submit: () => order.push("submit") });
+  const fence = f.queue.onSubmittedWorkDone;
+  f.queue.onSubmittedWorkDone = function() { order.push("fence"); return fence.call(this); };
+  Object.assign(f.game.engine, {
+    _endCurrentRenderPass() {}, _debugPopBeforeEndOfEncoder() {},
+    _snapshotRendering: { endFrame() {} },
+    _timestampQuery: { startFrame() {}, endFrame() {} },
+    _textureHelper: { destroyDeferredTextures() {}, setCommandEncoder() {} },
+    _bufferManager: { destroyDeferredBuffers() {} },
+    _cacheRenderPipeline: { endFrame() {} }, _cacheBindGroups: { endFrame() {} },
+    _bundleList: { reset() {} },
+    _counters: { numEnableEffects: 0, numEnableDrawWrapper: 0, numBundleCreationNonCompatMode: 0, numBundleReuseNonCompatMode: 0 },
+    countersLastFrame: {}, _commandBuffers: [],
+    _uploadEncoder: encoder(), _renderEncoder: encoder(),
+    _uploadEncoderDescriptor: {}, _renderEncoderDescriptor: {},
+    _debugMarkersEncoderGroups: [], _debugMarkersPassGroups: [],
+    _internalFrameCounter: 0, _frameId: 0,
+    flushFramebuffer: WebGPUEngine.prototype.flushFramebuffer,
+  });
+  f.game.frame(); assert.deepEqual(order, []);
+  WebGPUEngine.prototype.endFrame.call(f.game.engine);
+  assert.deepEqual(order, ["submit", "fence"]);
+  assert.equal(f.game.engine._frameId, 1);
+  f.resolve(); await Promise.resolve();
+  assert.equal(f.game.pendingGpuCompletionFence, undefined);
+});
