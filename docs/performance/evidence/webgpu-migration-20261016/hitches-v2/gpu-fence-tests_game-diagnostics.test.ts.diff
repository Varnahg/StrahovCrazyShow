+test("GPU completion fence consumes rejection and synchronous queue throw without interrupting render", async (t) => {
+  for (const mode of ["rejection", "sync-throw"]) {
+    const f = fenceFixture(); t.after(() => f.recorder.dispose());
+    if (mode === "sync-throw") f.queue.onSubmittedWorkDone = () => { throw new Error("private device detail"); };
+    f.recorder.start(); await f.recorder.flush(); f.game.frame();
+    assert.doesNotThrow(() => f.endFrame.notifyObservers(f.game.engine));
+    if (mode === "rejection") f.reject(new Error("private device detail"));
+    await Promise.resolve(); await f.recorder.flush();
+    assert.deepEqual(f.fenceRecords().map(r => r.data.status), ["queued", "failed"]);
+    const failed = f.fenceRecords()[1].data;
+    assert.equal(failed.failureKind, mode);
+    assert.equal(failed.completionLatencyMs, Number(failed.failedAtMs) - Number(failed.queuedAtMs));
+    assert.equal(JSON.stringify(f.fenceRecords()).includes("private device detail"), false);
+    assert.equal(f.game.pendingGpuCompletionFence, undefined);
+    assert.doesNotThrow(() => f.game.frame()); assert.equal(f.renders(), 2);
+  }
+});
+
+test("GPU completion fence diagnostic snapshot and sink failures are nonfatal", async (t) => {
+  for (const mode of ["snapshot", "health-snapshot", "sink"]) {
+    const f = fenceFixture(); t.after(() => f.recorder.dispose());
+    if (mode === "snapshot") f.game.frameLifecycleProfile.snapshot = () => { throw Error("snapshot"); };
+    if (mode === "health-snapshot") f.game.renderHealth.snapshot = () => { throw Error("snapshot"); };
+    if (mode === "sink") {
+      const event = f.recorder.event.bind(f.recorder);
+      f.recorder.event = ((kind: any, data: any) => {
+        if (data.stage === "gpu-completion-fence") throw Error("sink");
+        return event(kind, data);
+      }) as typeof f.recorder.event;
+    }
+    f.recorder.start(); await f.recorder.flush();
+    assert.doesNotThrow(() => f.game.frame());
+    assert.doesNotThrow(() => f.endFrame.notifyObservers(f.game.engine));
+    f.resolve(); await Promise.resolve();
+    assert.equal(f.game.pendingGpuCompletionFence, undefined);
+    assert.equal(f.calls(), mode === "sink" ? 1 : 0);
+    assert.equal(f.renders(), 1);
+  }
+});
+
+test("GPU completion fence disposal removes the observer and ignores both late Promise outcomes", async (t) => {
+  for (const mode of ["observer", "resolve", "reject"]) {
+    const f = fenceFixture(); t.after(() => f.recorder.dispose());
+    f.recorder.start(); await f.recorder.flush(); f.game.frame();
+    if (mode !== "observer") f.endFrame.notifyObservers(f.game.engine);
+    f.game.dispose();
+    assert.equal(f.game.pendingGpuCompletionFence, undefined);
+    f.endFrame.notifyObservers(f.game.engine);
+    assert.equal(f.calls(), mode === "observer" ? 0 : 1);
+    if (mode === "reject") f.reject(Error("late")); else f.resolve();
+    await Promise.resolve(); await f.recorder.flush();
+    assert.deepEqual(f.fenceRecords().map(r => r.data.status), mode === "observer" ? [] : ["queued"]);
+  }
+});
