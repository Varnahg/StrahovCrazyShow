+test("GPU completion fence is opt-in, WebGPU-only, finite and starts at CPU250ms", async (t) => {
+  for (const row of [
+    { cpu: 250, profile: false, gpu: true, count: 0 },
+    { cpu: 250, profile: true, gpu: false, count: 0 },
+    { cpu: 249.9, profile: true, gpu: true, count: 0 },
+    { cpu: NaN, profile: true, gpu: true, count: 0 },
+    { cpu: Infinity, profile: true, gpu: true, count: 0 },
+    { cpu: 250, profile: true, gpu: true, count: 1 },
+  ]) {
+    const f = fenceFixture(); t.after(() => f.recorder.dispose());
+    f.game.engine.isWebGPU = row.gpu;
+    if (!row.profile) f.game.frameLifecycleProfile = undefined;
+    // Invoke the extracted production boundary with an exact CPU duration;
+    // the other tests use complete actual frames to arm it.
+    f.game.captureGpuCompletionFence(100, row.cpu, 16);
+    f.endFrame.notifyObservers(f.game.engine);
+    assert.equal(f.calls(), row.count);
+    f.resolve(); await Promise.resolve();
+  }
+});
