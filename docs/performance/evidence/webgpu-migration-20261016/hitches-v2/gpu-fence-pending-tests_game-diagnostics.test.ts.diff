+test("GPU completion fence requires ready phase and zero faults independently of aggregate validity", async (t) => {
+  for (const boundary of ["arm", "observer", "promise"]) {
+    for (const state of [
+      { phase: "preparing", errorCount: 0 },
+      { phase: "invalid", errorCount: 0 },
+      { phase: "restart-required", errorCount: 0 },
+      { phase: "disposed", errorCount: 0 },
+      { phase: "ready", errorCount: 1 },
+    ]) {
+      const f = fenceFixture(); t.after(() => f.recorder.dispose());
+      f.recorder.start(); await f.recorder.flush();
+      if (boundary !== "arm") f.game.frame();
+      if (boundary === "promise") f.endFrame.notifyObservers(f.game.engine);
+      // Deliberately inconsistent aggregate valid proves the diagnostic uses
+      // the explicit phase/fault contract at each boundary.
+      f.game.renderHealth.snapshot = () => ({ rendererId: 73, generation: 3, valid: true, ...state });
+      if (boundary === "arm") f.game.frame();
+      f.endFrame.notifyObservers(f.game.engine);
+      f.resolve(); await Promise.resolve(); await f.recorder.flush();
+      assert.equal(f.calls(), boundary === "promise" ? 1 : 0, `${boundary}/${state.phase}/${state.errorCount}`);
+      assert.deepEqual(f.fenceRecords().map(r => r.data.status), boundary === "promise" ? ["queued"] : []);
+      assert.equal(f.game.pendingGpuCompletionFence, undefined);
+    }
+  }
+});
