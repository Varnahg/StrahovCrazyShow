+    assert.equal(f.game.car, f.car);
+    assert.equal(f.game.parkedCar, f.parked);
+    let disposedWrites = 0, disposedWorldReads = 0;
+    const setEnabled = dead.setEnabled, world = dead.computeWorldMatrix;
