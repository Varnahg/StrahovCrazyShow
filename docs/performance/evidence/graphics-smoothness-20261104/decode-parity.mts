import {readFile,writeFile} from 'node:fs/promises';import{createHash}from'node:crypto';import{parseTreePilotManifest}from'../../../../shared/tree-asset-types';import{decodeTreePrototype}from'../../../../client/tree-asset-loader';
const sha=(x:Uint8Array)=>createHash('sha256').update(x).digest('hex');const desc=JSON.parse(await readFile('shared/data/assets/tree-catalog.json','utf8'));const manifest=parseTreePilotManifest(JSON.parse(await readFile('public'+desc.url,'utf8')));const results=[];
for(const id of ['ipr-crown-032','ipr-crown-033']){const [key,p]=Object.entries(manifest.prototypes).find(([k,p])=>k===id||p.sourceTreeId===id)!;for(const lod of[0,1,2]as const){const asset=p.lods[lod],bytes=await readFile('public'+asset.url);if(sha(bytes)!==asset.sha256)throw Error('InputSHA');const buffer=bytes.buffer.slice(bytes.byteOffset,bytes.byteOffset+bytes.length)as ArrayBuffer;const parts=decodeTreePrototype(buffer,key,p,lod);results.push({id,lod,assetSha:asset.sha256,parts:parts.map(x=>({name:x.name,role:x.role,lod:x.lod,material:x.materialKey,attributes:Object.fromEntries(['positions','normals','uvs','indices','colors'].map(k=>{const a=(x as any)[k];return[k,a?{type:a.constructor.name,length:a.length,sha256:sha(new Uint8Array(a.buffer,a.byteOffset,a.byteLength))}:null]}))}))});}}
await writeFile(process.argv[2],JSON.stringify(results,null,2)+'\n',{flag:'wx'});console.log({assets:results.length,parts:results.reduce((n,r)=>n+r.parts.length,0)});
