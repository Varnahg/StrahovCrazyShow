{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "research",
    "alternatives",
    "decision",
    "steps",
    "sources",
    "risks",
    "intentGaps",
    "codeMap",
    "ready",
    "runtimeBlockers",
    "presentation"
  ],
  "properties": {
    "ready": {
      "type": "boolean"
    },
    "runtimeBlockers": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "research": {
      "type": "string"
    },
    "alternatives": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "decision": {
      "type": "string"
    },
    "steps": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "risks": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "intentGaps": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "codeMap": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "role"],
        "properties": {
          "path": {
            "type": "string"
          },
          "role": {
            "type": "string"
          }
        }
      }
    },
    "presentation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tasks", "ioMatrix", "acceptanceCriteria", "routeFacts"],
      "properties": {
        "tasks": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["path", "action", "reason", "basis"],
            "properties": {
              "path": {
                "type": "string"
              },
              "action": {
                "type": "string"
              },
              "reason": {
                "type": "string"
              },
              "basis": {
                "type": "string"
              }
            }
          }
        },
        "ioMatrix": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "scenario",
              "input",
              "output",
              "errorHandling",
              "basis"
            ],
            "properties": {
              "scenario": {
                "type": "string"
              },
              "input": {
                "type": "string"
              },
              "output": {
                "type": "string"
              },
              "errorHandling": {
                "type": "string"
              },
              "basis": {
                "type": "string"
              }
            }
          }
        },
        "acceptanceCriteria": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["given", "when", "then", "basis"],
            "properties": {
              "given": {
                "type": "string"
              },
              "when": {
                "type": "string"
              },
              "then": {
                "type": "string"
              },
              "basis": {
                "type": "string"
              }
            }
          }
        },
        "routeFacts": {
          "type": "object",
          "additionalProperties": false,
          "required": ["footprint", "irreversibles", "newDependencies"],
          "properties": {
            "footprint": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "irreversibles": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "newDependencies": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        }
      }
    }
  }
}
