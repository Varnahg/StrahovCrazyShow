{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "ready",
    "intentGaps",
    "runtimeBlockers",
    "evidence",
    "presentation",
    "priorReadiness"
  ],
  "properties": {
    "ready": {
      "type": "boolean"
    },
    "intentGaps": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "runtimeBlockers": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "presentation": {
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["tasks", "ioMatrix", "acceptanceCriteria", "routeFacts"],
          "properties": {
            "tasks": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["path", "action", "reason", "basis"],
                "properties": {
                  "path": {
                    "type": "string",
                    "pattern": "^[^\\r\\n]*\\S[^\\r\\n]*$",
                    "description": "Exact relative worker WRITE target only; never a read-only check input or controller artifact."
                  },
                  "action": {
                    "type": "string",
                    "pattern": "^[^\\r\\n]*\\S[^\\r\\n]*$"
                  },
                  "reason": {
                    "type": "string",
                    "pattern": "^[^\\r\\n]*\\S[^\\r\\n]*$"
                  },
                  "basis": {
                    "type": "string",
                    "pattern": "^[^\\r\\n]*\\S[^\\r\\n]*$"
                  }
                }
              }
            },
            "ioMatrix": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "scenario",
                  "input",
                  "output",
                  "errorHandling",
                  "basis"
                ],
                "properties": {
                  "scenario": {
                    "type": "string",
                    "pattern": "\\S"
                  },
                  "input": {
                    "type": "string",
                    "pattern": "\\S"
                  },
                  "output": {
                    "type": "string",
                    "pattern": "\\S"
                  },
                  "errorHandling": {
                    "type": "string",
                    "pattern": "\\S"
                  },
                  "basis": {
                    "type": "string",
                    "pattern": "\\S"
                  }
                }
              }
            },
            "acceptanceCriteria": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["given", "when", "then", "basis"],
                "properties": {
                  "given": {
                    "type": "string",
                    "pattern": "^[^\\r\\n]*\\S[^\\r\\n]*$"
                  },
                  "when": {
                    "type": "string",
                    "pattern": "^[^\\r\\n]*\\S[^\\r\\n]*$",
                    "description": "Only the triggering action/event. Put the expected outcome in then, never combine both here."
                  },
                  "then": {
                    "type": "string",
                    "pattern": "^[^\\r\\n]*\\S[^\\r\\n]*$",
                    "description": "Nonempty expected outcome, separately from the when trigger."
                  },
                  "basis": {
                    "type": "string",
                    "pattern": "^[^\\r\\n]*\\S[^\\r\\n]*$"
                  }
                }
              }
            },
            "routeFacts": {
              "type": "object",
              "additionalProperties": false,
              "required": ["footprint", "irreversibles", "newDependencies"],
              "properties": {
                "footprint": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "pattern": "\\S"
                  },
                  "minItems": 1,
                  "description": "Only exact relative worker WRITE filenames; no descriptions, basis annotations or controller paths."
                },
                "irreversibles": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "pattern": "\\S"
                  }
                },
                "newDependencies": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "pattern": "\\S"
                  }
                }
              }
            }
          }
        },
        {
          "type": "null"
        }
      ],
      "description": "Use null when ready=false or substantive gaps/blockers prevent truthful presentation. ready=true without blockers requires the complete object."
    },
    "priorReadiness": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sha256",
        "authorizationSha256",
        "intentGaps",
        "runtimeBlockers"
      ],
      "properties": {
        "sha256": {
          "type": "string"
        },
        "authorizationSha256": {
          "type": "string"
        },
        "intentGaps": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["index", "text", "resolution", "reason"],
            "properties": {
              "index": {
                "type": "integer",
                "minimum": 0
              },
              "text": {
                "type": "string"
              },
              "resolution": {
                "type": "string",
                "enum": [
                  "workflow-keep-full",
                  "spec-presentation",
                  "product-intent",
                  "runtime-prerequisite",
                  "unresolved"
                ]
              },
              "reason": {
                "type": "string"
              }
            }
          }
        },
        "runtimeBlockers": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["index", "text", "resolution", "reason"],
            "properties": {
              "index": {
                "type": "integer",
                "minimum": 0
              },
              "text": {
                "type": "string"
              },
              "resolution": {
                "type": "string",
                "enum": [
                  "workflow-keep-full",
                  "spec-presentation",
                  "product-intent",
                  "runtime-prerequisite",
                  "unresolved"
                ]
              },
              "reason": {
                "type": "string"
              }
            }
          }
        }
      }
    }
  }
}
