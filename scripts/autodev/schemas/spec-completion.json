{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "ready",
    "intentGaps",
    "runtimeBlockers",
    "evidence",
    "presentation",
    "priorReadiness"
  ],
  "properties": {
    "ready": {
      "type": "boolean"
    },
    "intentGaps": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "runtimeBlockers": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "presentation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tasks", "ioMatrix", "acceptanceCriteria", "routeFacts"],
      "properties": {
        "tasks": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["path", "action", "reason", "basis"],
            "properties": {
              "path": {
                "type": "string"
              },
              "action": {
                "type": "string"
              },
              "reason": {
                "type": "string"
              },
              "basis": {
                "type": "string"
              }
            }
          }
        },
        "ioMatrix": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "scenario",
              "input",
              "output",
              "errorHandling",
              "basis"
            ],
            "properties": {
              "scenario": {
                "type": "string"
              },
              "input": {
                "type": "string"
              },
              "output": {
                "type": "string"
              },
              "errorHandling": {
                "type": "string"
              },
              "basis": {
                "type": "string"
              }
            }
          }
        },
        "acceptanceCriteria": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["given", "when", "then", "basis"],
            "properties": {
              "given": {
                "type": "string"
              },
              "when": {
                "type": "string"
              },
              "then": {
                "type": "string"
              },
              "basis": {
                "type": "string"
              }
            }
          }
        },
        "routeFacts": {
          "type": "object",
          "additionalProperties": false,
          "required": ["footprint", "irreversibles", "newDependencies"],
          "properties": {
            "footprint": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "irreversibles": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "newDependencies": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "priorReadiness": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sha256",
        "authorizationSha256",
        "intentGaps",
        "runtimeBlockers"
      ],
      "properties": {
        "sha256": {
          "type": "string"
        },
        "authorizationSha256": {
          "type": "string"
        },
        "intentGaps": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["index", "text", "resolution", "reason"],
            "properties": {
              "index": {
                "type": "integer",
                "minimum": 0
              },
              "text": {
                "type": "string"
              },
              "resolution": {
                "type": "string",
                "enum": [
                  "workflow-keep-full",
                  "spec-presentation",
                  "product-intent",
                  "runtime-prerequisite",
                  "unresolved"
                ]
              },
              "reason": {
                "type": "string"
              }
            }
          }
        },
        "runtimeBlockers": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["index", "text", "resolution", "reason"],
            "properties": {
              "index": {
                "type": "integer",
                "minimum": 0
              },
              "text": {
                "type": "string"
              },
              "resolution": {
                "type": "string",
                "enum": [
                  "workflow-keep-full",
                  "spec-presentation",
                  "product-intent",
                  "runtime-prerequisite",
                  "unresolved"
                ]
              },
              "reason": {
                "type": "string"
              }
            }
          }
        }
      }
    }
  }
}
